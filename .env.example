# ============================================================
#  RafineAI Self-Hosted — Environment Configuration
#  Copy this file to `.env` and fill in the values.
#  `install.sh` generates secrets automatically if you use it.
# ============================================================

# ---- Deployment ----
# Image tag pulled from the registry (prod compose only).
RAFINE_VERSION=latest
# Public URL the panel is served from (used for OAuth2 redirects, CORS).
RAFINE_PUBLIC_URL=http://localhost

# ---- Database ----
POSTGRES_USER=rafine
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rafineai
# Connection string consumed by api (Python) and gateway (Go).
DATABASE_URL=postgres://rafine:change-me-strong-password@postgres:5432/rafineai?sslmode=disable

# ---- Core secrets ----
# Master key: signs gateway API keys (HMAC) AND encrypts provider credentials.
# MUST be identical across gateway and api. Min 32 bytes recommended.
RAFINE_MASTER_KEY=change-me-32-byte-random-master-key
# JWT signing secret for the panel/api session tokens.
JWT_SECRET=change-me-32-byte-random-jwt-secret
# Access token lifetime (minutes) and refresh token lifetime (days).
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14

# ---- Default owner (seeded on first boot) ----
OWNER_EMAIL=owner@rafine.local
OWNER_PASSWORD=change-me-owner-password

# ---- Gateway ----
GATEWAY_PORT=8080
# How often (seconds) the gateway syncs provider config + blocklist from DB.
GATEWAY_SYNC_INTERVAL_SEC=30
# Audit writer batch settings.
GATEWAY_AUDIT_BATCH_SIZE=50
GATEWAY_AUDIT_FLUSH_MS=2000

# ---- API (FastAPI) ----
API_PORT=8000

# ---- Panel (Next.js) ----
PANEL_PORT=3000

# ============================================================
#  LLM Provider credentials are NOT configured here.
#  After install, sign in as the owner/admin and add providers in the
#  panel (LLM Providers): either a shared API key (encrypted at rest) or
#  per-user OAuth2. Credentials live in the database, never in this file.
# ============================================================
